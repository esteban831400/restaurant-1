# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # serveur uniquement

# --- n8n (jamais exposé au navigateur) ---
N8N_WEBHOOK_SECRET=                   # secret HMAC n8n -> app (min. 16 caractères)
N8N_OUTBOUND_SECRET=                  # secret HMAC app -> n8n (différent du précédent)
N8N_WEBHOOK_ORDER_SEND=               # URL du webhook "Envoi des commandes"
N8N_WEBHOOK_ASSISTANT=                # URL du webhook multi-agent
# Les URLs des autres automatisations sont saisies dans Paramètres > Webhooks.

# --- Crons Vercel ---
CRON_SECRET=                          # min. 16 caractères

# --- Application ---
NEXT_PUBLIC_APP_URL=                  # URL publique de l'application (liens des e-mails d'invitation)
